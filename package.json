{
  "name": "gold-asa-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:playwright": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^2.3.2",
    "@folks-router/js-sdk": "^0.0.4",
    "@txnlab/use-wallet-defly": "^5.0.1",
    "@txnlab/use-wallet-exodus": "^5.0.1",
    "@txnlab/use-wallet-pera": "^5.0.1",
    "@txnlab/use-wallet-vue": "^5.0.1",
    "algorand-asa-gold": "^1.0.8",
    "algorand-authentication-component-vue": "^3.1.0",
    "algosdk": "^3.9.0",
    "algosdk2": "npm:algosdk@^2.7.0",
    "aos": "^2.3.4",
    "axios": "^1.12.2",
    "biatec-wallet-use-wallet-client": "^0.6.0",
    "buffer": "^6.0.3",
    "cross-fetch": "^4.0.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.22",
    "vue-carousel": "^0.18.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue-slick-carousel": "^1.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@rushstack/eslint-patch": "^1.12.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/aos": "^3.0.7",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.4.0",
    "compression-webpack-plugin": "^10.0.0",
    "cypress": "^13.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^22.1.0",
    "npm-run-all2": "^6.1.2",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "start-server-and-test": "^2.0.3",
    "typescript": "~5.2.0",
    "vite": "^4.5.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.27"
  },
  "packageManager": "pnpm@11.10.0"
}
